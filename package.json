{
  "name": "kuaforz-randevu",
  "version": "1.0.0",
  "description": "Modern kuaför randevu sistemi",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npx tsx watch src/server.ts",
    "dev:client": "npm run dev --prefix client",
    "start": "npx tsx src/server.ts",
    "build": "npm run build --prefix client && tsc",
    "tsc": "tsc --noEmit",
    "deploy:hosting": "npm run build --prefix client && firebase deploy --only hosting",
    "deploy:backend": "git push"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^12.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "firebase-tools": "^13.0.0"
  }
}
