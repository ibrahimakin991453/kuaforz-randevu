# Sunucu
PORT=5000

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Admin giriş şifresi (SHA-256 hash)
# Hash oluştur: node -e "console.log(require('crypto').createHash('sha256').update('1234').digest('hex'))"
ADMIN_PASSWORD_HASH=03ac674216f3e15c761ee1a5e255f067953623c8b388b4459e13f978d7c846f4

# JWT
JWT_SECRET=change-this-to-a-random-string
